#!/bin/sh
# Blocks a commit that contains a secret. Enable once per clone:
#   git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (winget install Gitleaks.Gitleaks). Commit blocked." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner -v || {
  echo "pre-commit: a secret was found in the staged changes. Remove it and commit again." >&2
  exit 1
}
